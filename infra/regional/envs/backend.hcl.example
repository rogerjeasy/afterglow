# Copy to <environment>-<region>.backend.hcl (git-ignored). Values come from the
# `backend_config_hint` output of the bootstrap stack. Use a DIFFERENT key for each
# environment and region so each has its own state.

bucket       = "afterglow-tfstate-123456789012"
key          = "regional/dev-eu-central-1/terraform.tfstate"
region       = "eu-central-1"
encrypt      = true
kms_key_id   = "arn:aws:kms:eu-central-1:123456789012:key/REPLACE-WITH-BOOTSTRAP-OUTPUT"
use_lockfile = true
