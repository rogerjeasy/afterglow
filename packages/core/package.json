{
  "name": "@afterglow/core",
  "version": "0.0.0",
  "private": true,
  "description": "Afterglow deterministic domain core: pure TypeScript, no I/O, property-tested.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fusion": "./src/fusion/index.ts",
    "./events": "./src/events/index.ts",
    "./cells": "./src/cells/index.ts",
    "./schedule": "./src/schedule/index.ts",
    "./thermal": "./src/thermal/index.ts",
    "./foodkeeper": "./src/foodkeeper/index.ts",
    "./household": "./src/household/index.ts",
    "./formulary": "./src/formulary/index.ts",
    "./heliograph": "./src/heliograph/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "devDependencies": {
    "@vitest/browser": "2.1.8",
    "fast-check": "3.23.2",
    "playwright": "1.65.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
