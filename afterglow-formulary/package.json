  "dependencies": {
    "@afterglow/adapters": "workspace:*",
    "@afterglow/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22",
    "fast-check": "3.23.2",
    "typescript": "5.7.2",
    "vite-node": "2.1.8",
    "vitest": "2.1.8"
  }
}
