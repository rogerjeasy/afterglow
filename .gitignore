node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Turborepo
.turbo/

# Test / coverage
coverage/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
*.swp

# Env and secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key

# Terraform: state and real values never enter git. Example files and the lock file do.
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
*.backend.hcl
!backend.hcl.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info

# Playwright
playwright-report/
test-results/
